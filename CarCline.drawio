        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass User {\n    + id: int\n    + fullName: String\n    + phone: String\n    + login()\n}\n\nclass Administrator {\n}\n\nclass Manager {\n}\n\nclass Washer {\n    + serves(): void\n}\n\nclass Client {\n    + makes(): void\n    + writes(): void\n    + owns(): void\n}\n\nUser &lt;|-- Administrator\nUser &lt;|-- Manager\nUser &lt;|-- Washer\nUser &lt;|-- Client\n\nclass BookingManager {\n    &lt;&lt;controller&gt;&gt;\n    + getAvailableSlots(date): List&lt;Timeslot&gt;\n    + createBooking(clientId, slotId): Booking\n}\n\nclass Booking {\n    + id: int\n    + status: String\n    + createdAt: DateTime\n}\n\nclass Timeslot {\n    + startTime: DateTime\n    + endTime: DateTime\n    + isFree: bool\n}\n\nclass Box {\n    + number: int\n    + status: String\n}\n\nclass Service {\n    + name: String\n    + price: decimal\n}\n\nclass Payment {\n    + amount: decimal\n    + method: String\n    + status: String\n}\n\nclass Vehicle {\n    + plateNumber: String\n    + model: String\n}\n\nclass Notification {\n    + channel: String\n    + text: String\n    + sendConfirmation(): void\n}\n\nclass Review {\n    + rating: int\n    + comment: String\n}\n\nClient --&gt; Booking : makes\nWasher --&gt; Booking : serves\nBookingManager ..&gt; Booking : &lt;&lt;creates&gt;&gt;\nBookingManager ..&gt; Timeslot : &lt;&lt;checks&gt;&gt;\nBookingManager ..&gt; Notification : &lt;&lt;uses&gt;&gt;\nBooking --&gt; Timeslot : 1\nBooking --&gt; Box : 1\nBooking --&gt; Service : 1..*\nBooking --&gt; Payment : 0..1\nClient --&gt; Vehicle : owns\nClient --&gt; Review : writes\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6ZC2fJjvu6QEtUCvMYZX-1">
